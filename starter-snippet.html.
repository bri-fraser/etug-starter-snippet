<script>
(function () {
  "use strict";

  var form = document.getElementById("tiy1-form");
  if (!form) { return; }

  var radios = form.querySelectorAll('input[name="tiy1-choice"]');
  var checkBtn = document.getElementById("tiy1-check");
  var resetBtn = document.getElementById("tiy1-reset");
  var feedback = document.getElementById("tiy1-feedback");

  // EDIT: feedback for each choice. Explain why, not just right or wrong.
  var FEEDBACK = {
    a: "Design A asks students to recall a definition. Someone could answer it perfectly without being able to use the idea. Design B is stronger for this goal.",
    b: "Design B puts students in a realistic decision and asks them to apply the idea and explain their reasoning. That's what the goal asks for. Design A only checks whether they remember the definition."
  };

  // Colours. Status is always stated in words too, never by colour alone.
  var COLOURS = {
    correct:   { text: "#1B5E20", border: "#1B5E20", bg: "#E8F5E9" },
    incorrect: { text: "#8E0F09", border: "#8E0F09", bg: "#FBEAEA" },
    focus: "#3243DC"
  };

  // Show the drawn dot for whichever real radio button is checked.
  function syncDots() {
    radios.forEach(function (radio) {
      var dot = radio.parentNode.querySelector(".tiy1-dot");
      dot.style.display = radio.checked ? "block" : "none";
    });
  }

  radios.forEach(function (radio) {
    var circle = radio.parentNode.querySelector(".tiy1-circle");
    var card = radio.parentNode;

    radio.addEventListener("change", syncDots);

    // Focus is shown on the drawn circle and its card, since the real input is hidden.
    radio.addEventListener("focus", function () {
      circle.style.outline = "3px solid " + COLOURS.focus;
      circle.style.outlineOffset = "2px";
      card.style.borderColor = COLOURS.focus;
    });
    radio.addEventListener("blur", function () {
      circle.style.outline = "none";
      card.style.borderColor = "#CCCCCC";
    });
  });

  function showFeedback(kind, heading, text) {
    var c = COLOURS[kind];
    feedback.style.display = "block";
    feedback.style.background = c.bg;
    feedback.style.borderLeftColor = c.border;
    feedback.innerHTML = "";
    var strong = document.createElement("strong");
    strong.textContent = heading + " ";
    strong.style.color = c.text;
    feedback.appendChild(strong);
    feedback.appendChild(document.createTextNode(text));
  }

  checkBtn.addEventListener("click", function () {
    var selected = form.querySelector('input[name="tiy1-choice"]:checked');
    if (!selected) {
      showFeedback("incorrect", "Choose a design first.", "Select Design A or Design B, then check your answer.");
      return;
    }
    var isCorrect = selected.value === form.getAttribute("data-answer");
    showFeedback(isCorrect ? "correct" : "incorrect", isCorrect ? "Correct." : "Not quite.", FEEDBACK[selected.value]);
  });

  resetBtn.addEventListener("click", function () {
    form.reset();
    // form.reset() doesn't fire change events, so clear the drawn dots by hand.
    syncDots();
    feedback.style.display = "none";
    feedback.innerHTML = "";
    radios[0].focus();
  });

  // Hover and focus styles for the buttons (done in JavaScript because
  // many LMS editors strip the <style> blocks that would normally hold them).
  function addButtonStates(btn, normalBg, normalText, hoverBg, hoverText) {
    function on()  { btn.style.background = hoverBg;  btn.style.color = hoverText; }
    function off() { btn.style.background = normalBg; btn.style.color = normalText; }
    btn.addEventListener("mouseenter", on);
    btn.addEventListener("mouseleave", off);
    btn.addEventListener("focus", function () {
      btn.style.outline = "3px solid " + COLOURS.focus;
      btn.style.outlineOffset = "2px";
    });
    btn.addEventListener("blur", function () { btn.style.outline = "none"; });
  }
  addButtonStates(checkBtn, "#1F2224", "#FFFFFF", "#494C4E", "#FFFFFF");
  addButtonStates(resetBtn, "#FFFFFF", "#1F2224", "#ECECEC", "#1F2224");
})();
</script>

