<div id="tiy1-wrap" style="box-sizing:border-box; max-width:760px; margin:1.5rem 0; padding:1.5rem; background:#ECECEC; border:1px solid #CFCFCF; border-radius:6px; font-family:inherit; font-size:1rem; line-height:1.5; color:#1F2224;">

  <h3 style="margin:0 0 0.5rem 0; font-size:1.25rem; font-weight:700; line-height:1.3; color:#1F2224;">Try It Yourself</h3>

  <!-- EDIT: instructions to the learner -->
  <p style="margin:0 0 1rem 0; color:#494C4E;">Read the goal, compare the two quiz questions, and choose the one that does a better job of meeting it. This is a self-check with no grade attached.</p>

  <!-- data-answer = the value of the correct option ("a" or "b") -->
  <form id="tiy1-form" data-answer="b" style="margin:0; padding:0;">

    <fieldset style="box-sizing:border-box; margin:0 0 1rem 0; padding:1rem 1.25rem; min-width:0; background:#FFFFFF; border:1px solid #CCCCCC; border-radius:6px;">
      <legend style="position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;">Choose the stronger design</legend>

      <!-- EDIT: the goal both designs are judged against -->
      <p id="tiy1-goal" style="margin:0 0 1rem 0; font-weight:600; color:#1F2224;">Goal: Students can apply the idea of opportunity cost to an everyday decision. Which quiz question checks that better?</p>

      <div style="display:flex; flex-wrap:wrap; gap:1rem;">

        <!-- Option A -->
        <label for="tiy1-a" style="box-sizing:border-box; flex:1 1 260px; display:flex; gap:0.75rem; align-items:flex-start; margin:0; padding:1rem; background:#F7F7F7; border:1px solid #CCCCCC; border-radius:6px; cursor:pointer; font-weight:400; color:#1F2224;">
          <input type="radio" id="tiy1-a" name="tiy1-choice" value="a" aria-describedby="tiy1-goal" style="position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;">
          <span class="tiy1-circle" aria-hidden="true" style="box-sizing:border-box; flex:0 0 auto; display:flex; align-items:center; justify-content:center; width:1.25rem; height:1.25rem; margin-top:0.15rem; border:2px solid #494C4E; border-radius:50%; background:#FFFFFF;">
            <span class="tiy1-dot" style="display:none; width:0.6rem; height:0.6rem; border-radius:50%; background:#1F2224;"></span>
          </span>
          <span style="display:block;">
            <span style="display:block; font-weight:700; margin-bottom:0.25rem;">Design A</span>
            <!-- EDIT: design A -->
            <span style="display:block;">“Define opportunity cost.”</span>
          </span>
        </label>

        <!-- Option B -->
        <label for="tiy1-b" style="box-sizing:border-box; flex:1 1 260px; display:flex; gap:0.75rem; align-items:flex-start; margin:0; padding:1rem; background:#F7F7F7; border:1px solid #CCCCCC; border-radius:6px; cursor:pointer; font-weight:400; color:#1F2224;">
          <input type="radio" id="tiy1-b" name="tiy1-choice" value="b" aria-describedby="tiy1-goal" style="position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0;">
          <span class="tiy1-circle" aria-hidden="true" style="box-sizing:border-box; flex:0 0 auto; display:flex; align-items:center; justify-content:center; width:1.25rem; height:1.25rem; margin-top:0.15rem; border:2px solid #494C4E; border-radius:50%; background:#FFFFFF;">
            <span class="tiy1-dot" style="display:none; width:0.6rem; height:0.6rem; border-radius:50%; background:#1F2224;"></span>
